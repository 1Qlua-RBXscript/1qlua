--==================== PARTICLES ====================
rebuildParticles = function() end
do
    local GY, G = GraphicsGY, Config.Graphics
    local starOrb, spinConn, followConn = nil, nil, nil

    local function clearAll()
        if spinConn then spinConn:Disconnect(); spinConn = nil end
        if followConn then followConn:Disconnect(); followConn = nil end
        if starOrb then starOrb:Destroy(); starOrb = nil end
        local old = workspace:FindFirstChild("SolaraParticles")
        if old then old:Destroy() end
    end

    local function applyTo(em)
        if not em or not em.Parent then return end
        pcall(function()
            em.Texture = G.P_Texture
            em.Rate = G.P_Rate
            em.Lifetime = NumberRange.new(math.min(G.P_LifetimeMin, G.P_LifetimeMax),
                math.max(G.P_LifetimeMin, G.P_LifetimeMax))
            em.Size = NumberSequence.new(math.min(G.P_SizeMin, G.P_SizeMax),
                math.max(G.P_SizeMin, G.P_SizeMax))
            em.Color = G.P_UseGradient
                and ColorSequence.new(G.P_ColorStart or WHITE, G.P_ColorEnd or WHITE)
                or ColorSequence.new(G.P_ColorStart or WHITE)
            em.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, G.P_TranspStart),
                NumberSequenceKeypoint.new(0.5, G.P_TranspMid),
                NumberSequenceKeypoint.new(1, G.P_TranspEnd),
            })
            em.Speed = NumberRange.new(math.min(G.P_SpeedMin, G.P_SpeedMax),
                math.max(G.P_SpeedMin, G.P_SpeedMax))
            em.SpreadAngle = Vector2.new(G.P_SpreadAngle, G.P_SpreadAngle)
            em.Acceleration = Vector3.new(G.P_AccelX, G.P_AccelY, G.P_AccelZ)
            em.Drag = G.P_Drag
            em.Rotation = NumberRange.new(math.min(G.P_RotMin, G.P_RotMax),
                math.max(G.P_RotMin, G.P_RotMax))
            em.RotSpeed = NumberRange.new(math.min(G.P_RotSpeedMin, G.P_RotSpeedMax),
                math.max(G.P_RotSpeedMin, G.P_RotSpeedMax))
            em.LightEmission = G.P_LightEmission
            em.LightInfluence = G.P_LightInfluence
            em.ZOffset = G.P_ZOffset
            em.Squash = NumberSequence.new(G.P_Squash)
            em.VelocityInheritance = G.P_VelocityInherit
            em.EmissionDirection = Enum.NormalId[G.P_EmissionDir] or Enum.NormalId.Top
            em.WindAffectsDrag = G.P_WindAffectsDrag
            em.LockedToPart = G.P_LockedToPart
            em.TimeScale = G.P_TimeScale
            pcall(function()
                em.Orientation = Enum.ParticleOrientation[G.P_Orientation]
                    or Enum.ParticleOrientation.FacingCamera
            end)
            if G.P_Mode == "Single" then
                em.Shape = Enum.ParticleEmitterShape[G.P_Shape] or Enum.ParticleEmitterShape.Box
                em.ShapeStyle = Enum.ParticleEmitterShapeStyle[G.P_ShapeStyle] or Enum.ParticleEmitterShapeStyle.Volume
                em.ShapeInOut = Enum.ParticleEmitterShapeInOut[G.P_ShapeInOut] or Enum.ParticleEmitterShapeInOut.Outward
                em.ShapePartial = G.P_ShapePartial
            end
            em.Enabled = G.P_Enabled
        end)
    end

    local function build()
        clearAll()
        if not G.P_Enabled then return end
        local ch = LocalPlayer.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local p = Instance.new("Part")
        p.Name = "SolaraParticles"
        p.Shape = Enum.PartType.Block
        p.Material = Enum.Material.ForceField
        p.Color = G.P_OrbColor or WHITE
        p.Transparency = G.P_ShowOrb and G.P_OrbTransparency or 1
        p.Reflectance = 0.1
        p.Size = Vector3.new(G.P_OrbRadius*2, G.P_OrbRadius*2, G.P_OrbRadius*2)
        p.Anchored = true; p.CanCollide = false; p.CanQuery = false
        p.CanTouch = false; p.Massless = true
        p.CFrame = CFrame.new(hrp.Position); p.Parent = workspace
        starOrb = p
        if G.P_Mode == "Single" then
            local em = Instance.new("ParticleEmitter"); em.Name = "Main"; em.Parent = p
            applyTo(em)
        else
            for _ = 1, math.floor(G.P_MultiCount) do
                local dir
                repeat
                    dir = Vector3.new((math.random()-0.5)*2, (math.random()-0.5)*2, (math.random()-0.5)*2)
                until dir.Magnitude <= 1 and dir.Magnitude > 0.01
                local att = Instance.new("Attachment"); att.Position = dir * G.P_OrbRadius; att.Parent = p
                local em = Instance.new("ParticleEmitter")
                em.Shape = Enum.ParticleEmitterShape.Sphere
                em.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
                em.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
                em.Parent = att; applyTo(em)
            end
        end
        followConn = RunService.Heartbeat:Connect(function()
            if starOrb and starOrb.Parent and hrp.Parent then
                starOrb.Position = hrp.Position
            elseif followConn then
                followConn:Disconnect(); followConn = nil
            end
        end)
        Runtime.Connections[#Runtime.Connections+1] = followConn
        if G.P_AutoRotate then
            local acc = 0
            spinConn = RunService.Heartbeat:Connect(function(dt)
                if starOrb and starOrb.Parent then
                    acc = math.rad(G.P_AutoRotateSpeed) * dt
                    starOrb.CFrame = starOrb.CFrame * CFrame.Angles(0, acc, 0)
                end
            end)
            Runtime.Connections[#Runtime.Connections+1] = spinConn
        end
    end

    rebuildParticles = function() clearAll(); if G.P_Enabled then build() end end

    bind(LocalPlayer.CharacterAdded, function()
        if G.P_Enabled then task.wait(0.6); build() end
    end)

    mk("TextLabel", GraphicsPage, {
        BackgroundTransparency=1, Position=UDim2.fromOffset(20, GraphicsGY.y),
        Size=UDim2.new(1,-40,0,20), Font=Enum.Font.Code, Text="PARTICLES",
        TextColor3=mkColor(220,220,225), TextSize=14,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=3,
    })
    local GY0 = { y = GraphicsGY.y + 24 }

    local function pStep(h) GY0.y = GY0.y + h end
    local function pNum(label, key, minV, maxV)
        local p = settingBlock(GraphicsPage, label, G[key],
