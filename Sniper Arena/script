--==================== VFLY ====================
do
    local st = { Active=false, Conn=nil, Vel=Vector3.new(), Char=nil, Root=nil }
    local function setChar(c)
        st.Char = c; st.Root = c:WaitForChild("HumanoidRootPart")
    end
    bind(LocalPlayer.CharacterAdded, setChar)
    if LocalPlayer.Character then setChar(LocalPlayer.Character) end
    local function heartbeat(dt)
        if not st.Active then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local vel = Vector3.new()
        if not UserInputService:GetFocusedTextBox() then
            local s = Config.Flight.Speed
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then vel = vel + cam.CFrame.LookVector * s end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then vel = vel - cam.CFrame.LookVector * s end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then vel = vel - cam.CFrame.RightVector * s end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then vel = vel + cam.CFrame.RightVector * s end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vel = vel + cam.CFrame.UpVector * s end
            if UserInputService:IsKeyDown(Config.Flight.SpeedKey) then
                vel = vel * Config.Flight.SpeedMultiplier
            end
        end
        local root = st.Root
        if root and root.Parent then
            local ok, car = pcall(function() return root:GetRootPart() end)
            if not ok or not car or car.Anchored then return end
            local ok2, owned = pcall(function() return isnetworkowner(car) end)
            if not ok2 or not owned then return end
            st.Vel = st.Vel:Lerp(vel, math.clamp(dt * Config.Flight.Acceleration, 0, 1))
            car.Velocity = st.Vel + Vector3.new(0,2,0)
            if car ~= root then
                car.RotVelocity = Vector3.new()
                car.CFrame = car.CFrame:Lerp(CFrame.lookAt(
                    car.Position, car.Position + st.Vel + cam.CFrame.LookVector
                ), math.clamp(dt * Config.Flight.TurnSpeed, 0, 1))
            end
        end
    end
    local function notify(t)
        pcall(function()
            StarterGui:SetCore("SendNotification", { Title="Vfly", Text=t, Duration=2 })
        end)
    end
    toggleFlight = function(force)
        local new = force
        if new == nil then new = not st.Active end
        if new == st.Active then return end
        if new then
            st.Active = true
            st.Vel = st.Root and st.Root.Velocity or Vector3.new()
            st.Conn = RunService.Heartbeat:Connect(heartbeat)
            Runtime.Connections[#Runtime.Connections+1] = st.Conn
            notify("Flight enabled")
        else
            st.Active = false
            if st.Conn then st.Conn:Disconnect(); st.Conn = nil end
            notify("Flight disabled")
        end
        Config.Flight.Active = new
        refreshAllUI()
    end
    Runtime.CleanupFlight = function()
        if st.Conn then pcall(function() st.Conn:Disconnect() end) end
    end
end

--==================== AIM LOGIC ====================
do
    local NPCCache, NPCLookup = {}, {}
    local function tryAddNPC(inst)
        if inst:IsA("Humanoid") then
            task.defer(function()
                local m = inst.Parent
                if m and m:IsA("Model")
                   and not Players:GetPlayerFromCharacter(m)
                   and not NPCLookup[m] then
                    NPCLookup[m] = true; NPCCache[#NPCCache+1] = m
                end
            end)
        end
    end
    for _, d in ipairs(workspace:GetDescendants()) do tryAddNPC(d) end
    bind(workspace.DescendantAdded, tryAddNPC)

    local CurrentTarget = nil
    local function isPlayerObj(t) return typeof(t) == "Instance" and t:IsA("Player") end
    local function isValidTarget(t)
        if not t then return false end
        if isPlayerObj(t) then
            if t.Parent ~= Players then return false end
            if Blacklist[t.UserId] or Blacklist[tostring(t.UserId)] then return false end
            local ch = t.Character
            if not ch or not ch:FindFirstChild("Head") then return false end
            local h = ch:FindFirstChildOfClass("Humanoid")
            return h and h.Health > 0
        end
        if not t:IsDescendantOf(workspace) then return false end
        if Players:GetPlayerFromCharacter(t) then return false end
        if not t:FindFirstChild("Head") then return false end
        local h = t:FindFirstChildOfClass("Humanoid")
        return h and h.Health > 0
    end
    local function getHeadPos(t)
        if not t then return nil end
        if isPlayerObj(t) then
            local ch = t.Character
            return ch and (ch:FindFirstChild("Head") and ch.Head.Position)
        end
        local h = t:FindFirstChild("Head")
        return h and h.Position
    end
    local function isAimingNow()
        if not Config.Aim.Active then return false end
        if Config.Aim.Mode == "Hold" then
            return UserInputService:IsKeyDown(Config.Aim.AimKey)
        elseif Config.Aim.Mode == "Toggle" then
            return Config.Aim.ToggleActive == true
        end
        return false
    end
    local function restoreAutoRotate()
        local ch = LocalPlayer.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if hum and not hum.AutoRotate then hum.AutoRotate = true end
    end
    bind(RunService.RenderStepped, function()
        if not isAimingNow() then
            CurrentTarget = nil
            restoreAutoRotate()
            return
        end
        local cam = workspace.CurrentCamera
        if not cam then return end
        if not isValidTarget(CurrentTarget) then CurrentTarget = nil end
        if not CurrentTarget then
            local mpos = UserInputService:GetMouseLocation()
            local bestDist, best = Config.Aim.FOVRadius, nil
            if Config.Aim.TargetPlayers then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and isValidTarget(p) then
                        local hp = getHeadPos(p)
                        if hp then
                            local pos, vis = cam:WorldToViewportPoint(hp)
                            if vis then
                                local m = (Vector2.new(pos.X, pos.Y) - mpos).Magnitude
                                if m < bestDist then bestDist = m; best = p end
                            end
                        end
                    end
                end
            end
            if Config.Aim.TargetNPCs then
                for i = #NPCCache, 1, -1 do
                    local m = NPCCache[i]
                    if not m:IsDescendantOf(workspace) then
                        NPCLookup[m] = nil; table.remove(NPCCache, i)
                    elseif isValidTarget(m) then
                        local hp = getHeadPos(m)
                        if hp then
                            local pos, vis = cam:WorldToViewportPoint(hp)
                            if vis then
                                local d = (Vector2.new(pos.X, pos.Y) - mpos).Magnitude
                                if d < bestDist then bestDist = d; best = m end
                            end
                        end
                    end
                end
            end
            CurrentTarget = best
        end
        if CurrentTarget then
            local hp = getHeadPos(CurrentTarget)
            if hp then
                if Config.Aim.AimType == "Real" then
                    local ch = LocalPlayer.Character
                    local root = ch and ch:FindFirstChild("HumanoidRootPart")
                    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                    if root and hum then
                        hum.AutoRotate = false
                        local cur = root.Position
                        local lookAt = Vector3.new(hp.X, cur.Y, hp.Z)
                        if (lookAt - cur).Magnitude > 0.05 then
                            local targetCF = CFrame.lookAt(cur, lookAt)
                            local rotLerp = math.clamp(math.max(Config.Aim.Smoothness, 0.35), 0, 1)
                            root.CFrame = root.CFrame:Lerp(targetCF, rotLerp)
                        end
                    end
                end
                cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, hp), Config.Aim.Smoothness)
            end
        end
    end)
end

