-- drawing fallback (no per-frame property churn)
local function espNewDrawing(kind)
    if Drawing and type(Drawing.new) == "function" then
        local ok, d = pcall(Drawing.new, kind)
        if ok and d then return d end
    end
    local visual = Instance.new("Frame", Gui)
    visual.BorderSizePixel = 0
    visual.Visible = false
    visual.BackgroundTransparency = 1
    local props = {
        Visible=false, Color=Color3.new(1,1,1), Transparency=1, Thickness=1,
        ZIndex=1, From=Vector2.zero, To=Vector2.zero,
    }
    local removed = false
    local last = { from = nil, to = nil, color = nil, thick = nil, vis = nil, transp = nil }
    local function render()
        if removed then return end
        local from, to = props.From, props.To
        if last.from ~= from or last.to ~= to then
            local d = to - from
            local mid = (from + to) / 2
            visual.AnchorPoint = Vector2.new(0.5, 0.5)
            visual.Position = UDim2.fromOffset(mid.X, mid.Y)
            visual.Size = UDim2.fromOffset(d.Magnitude, math.max(props.Thickness, 0.1))
            visual.Rotation = math.deg(math.atan2(d.Y, d.X))
            last.from, last.to = from, to
        end
        if last.color ~= props.Color then
            visual.BackgroundColor3 = props.Color; last.color = props.Color
        end
        if last.transp ~= props.Transparency then
            visual.BackgroundTransparency = 1 - props.Transparency; last.transp = props.Transparency
        end
        if last.vis ~= props.Visible then
            visual.Visible = props.Visible; last.vis = props.Visible
        end
    end
    return setmetatable({}, {
        __index = function(_, k)
            if k == "Remove" or k == "Destroy" then
                return function() if not removed then removed = true; visual:Destroy() end end
            end
            return props[k]
        end,
        __newindex = function(_, k, v) props[k] = v; render() end,
    })
end

local function espNewLines(n)
    local t = table.create(n)
    for i = 1, n do t[i] = espNewDrawing("Line") end
    return t
end

