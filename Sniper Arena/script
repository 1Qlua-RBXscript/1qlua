local function mk(cls, parent, props)
    local o = Instance.new(cls)
    for k, v in next, props do o[k] = v end
    o.Parent = parent
    return o
end
local function corner(o, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 4); c.Parent = o; return c
end
local function stroke(o, col, th)
    local s = Instance.new("UIStroke")
    s.Color = col; s.Thickness = th or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = o; return s
end
local function addBtnFx(btn, strength)
    strength = strength or 0.04
    btn.AutoButtonColor = false
    if btn:FindFirstChildOfClass("UIScale") then return end
    local sc = Instance.new("UIScale"); sc.Scale = 1; sc.Parent = btn
    bind(btn.MouseEnter, function() TweenService:Create(sc, TweenInfo.new(0.12), {Scale=1+strength}):Play() end)
    bind(btn.MouseLeave, function() TweenService:Create(sc, TweenInfo.new(0.15), {Scale=1}):Play() end)
    bind(btn.MouseButton1Down, function() TweenService:Create(sc, TweenInfo.new(0.06), {Scale=1-strength*0.6}):Play() end)
    bind(btn.MouseButton1Up, function() TweenService:Create(sc, TweenInfo.new(0.12), {Scale=1+strength}):Play() end)
end

