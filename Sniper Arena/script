    ESPStorage[p] = a
end

local function espAddNPC(model)
    if ESPNPCStorage[model] then return end
    local a = espCreateEntity()
    espCacheChar(a, model)
    ESPNPCStorage[model] = a
end

local function espHide(a)
    if a._headVisible then a.HeadImg.Visible = false; a._headVisible = false end
    if a._boxVisible then
        a.BoxFrame.Visible = false
        for i = 1, #a.BoxLines do if a.BoxLines[i].Visible then a.BoxLines[i].Visible = false end end
        a._boxVisible = false
    end
    if a._hpVisible then
        a.HPBar.Visible = false
        a.HPFill.Visible = false
        a.HPSegContainer.Visible = false
        a.HPLabel.Visible = false
        a.DistLabel.Visible = false
        a._hpVisible = false
    end
    for i = 1, #a.Lines do
        if a.Lines[i].Visible then a.Lines[i].Visible = false end
    end
end

-- called only when settings change (dirty)
local function espApplyStyle(a)
    local E = Config.ESP
    a.HeadImg.Image = E.HeadImage
    a.BoxStroke.Color = E.BoxColor
    a.BoxStroke.Thickness = E.BoxThickness
    a.BoxStroke.Transparency = E.BoxTransparency

    a.HPFill.BackgroundColor3 = E.HPColor
    for i = 1, 10 do a.HPSegments[i].BackgroundColor3 = E.HPColor end

    local strokeTr = E.StrokeEnabled and E.StrokeTransparency or 1

    a.HPLabel.TextColor3 = E.HPTextColor
    a.HPLabel.TextTransparency = E.HPTextTransparency
    a.HPLabel.TextStrokeTransparency = strokeTr
    a.HPLabel.TextSize = E.HPSize
    a.HPLabel.Font = Enum.Font[E.HPFont] or Enum.Font.GothamBold

    a.DistLabel.TextColor3 = E.DistTextColor
    a.DistLabel.TextTransparency = E.DistTextTransparency
    a.DistLabel.TextStrokeTransparency = strokeTr
    a.DistLabel.TextSize = E.DistSize
    a.DistLabel.Font = Enum.Font[E.DistFont] or Enum.Font.GothamBold

    -- corner styles
    local hpStyle = E.HPBarStyle or 1
    local rad = (hpStyle == 1) and UDim.new(1,0) or UDim.new(0,0)
    local bc = a.HPBar:FindFirstChildOfClass("UICorner")
    local fc = a.HPFill:FindFirstChildOfClass("UICorner")
    if bc then bc.CornerRadius = rad end
    if fc then fc.CornerRadius = rad end
end

local function espDrawBones(a, cam)
    local bones = a.bones
    if not bones and a.hum and a.hum.Parent then
        local rig = a.hum.RigType == Enum.HumanoidRigType.R15 and ESPBones.R15 or ESPBones.R6
        local char = a.hum.Parent
        bones = table.create(#rig)
        for i, b in ipairs(rig) do
            bones[i] = { char:FindFirstChild(b[1]), char:FindFirstChild(b[2]), b[3] }
        end
        a.bones = bones
    end
    if not bones then return end
    local colors = Config.ESP.Colors
    local thick = Config.ESP.Thickness
    local hide = Config.ESP.HideHead
    for i = 1, #bones do
        local p1, p2, part = bones[i][1], bones[i][2], bones[i][3]
        local line = a.Lines[i]
        if line then
            if not (hide and part == "Head") and p1 and p2 and p1.Parent and p2.Parent then
                local pos1, v1 = cam:WorldToViewportPoint(p1.Position)
                local pos2, v2 = cam:WorldToViewportPoint(p2.Position)
                if v1 and v2 then
                    line.From = Vector2.new(pos1.X, pos1.Y)
                    line.To = Vector2.new(pos2.X, pos2.Y)
                    line.Color = colors[part] or WHITE
                    line.Thickness = thick
                    line.Visible = true
                elseif line.Visible then
                    line.Visible = false
                end
            elseif line.Visible then
                line.Visible = false
            end
        end
    end
end

local function espHideBones(a)
    for i = 1, #a.Lines do
        if a.Lines[i].Visible then a.Lines[i].Visible = false end
    end
end

local function espDrawBox(a, left, top, right, bottom)
    local E = Config.ESP
    local style = E.BoxStyle or 2
    local col = E.BoxColor
    local thick = E.BoxThickness
    local tr = 1 - E.BoxTransparency

    for i = 1, #a.BoxLines do
        if a.BoxLines[i].Visible then a.BoxLines[i].Visible = false end
    end
    a.BoxFrame.Visible = false
    a._boxVisible = true

    if style == 2 then
        a.BoxFrame.Position = UDim2.fromOffset(left, top)
        a.BoxFrame.Size = UDim2.fromOffset(math.max(right-left,1), math.max(bottom-top,1))
        a.BoxFrame.Visible = true
        return
    end

    local lines = a.BoxLines
    local w, h = math.max(right-left,1), math.max(bottom-top,1)
    local cSize = math.clamp(math.min(w,h)*0.28, 6, 45)

    if style == 1 then
        local segs = {
            {Vector2.new(left,top), Vector2.new(left+cSize,top)},
            {Vector2.new(left,top), Vector2.new(left,top+cSize)},
            {Vector2.new(right-cSize,top), Vector2.new(right,top)},
            {Vector2.new(right,top), Vector2.new(right,top+cSize)},
            {Vector2.new(left,bottom-cSize), Vector2.new(left,bottom)},
            {Vector2.new(left,bottom), Vector2.new(left+cSize,bottom)},
            {Vector2.new(right-cSize,bottom), Vector2.new(right,bottom)},
            {Vector2.new(right,bottom-cSize), Vector2.new(right,bottom)},
        }
        for i = 1, 8 do
            local ln = lines[i]
            if ln then
                ln.From, ln.To = segs[i][1], segs[i][2]
                ln.Color, ln.Thickness, ln.Transparency = col, thick, tr
                ln.Visible = true
            end
        end
    elseif style == 3 then
        local segC, r, idx = 5, cSize, 1
        local function arc(cx, cy, a1, a2)
            for i = 0, segC-1 do
                local t1 = a1 + (a2-a1)*(i/segC)
                local t2 = a1 + (a2-a1)*((i+1)/segC)
                local ln = lines[idx]
                if ln then
                    ln.From = Vector2.new(cx+math.cos(t1)*r, cy+math.sin(t1)*r)
                    ln.To   = Vector2.new(cx+math.cos(t2)*r, cy+math.sin(t2)*r)
                    ln.Color, ln.Thickness, ln.Transparency = col, thick, tr
                    ln.Visible = true
                end
                idx = idx + 1
            end
        end
        arc(left+r, top+r, math.rad(180), math.rad(270))
        arc(right-r, top+r, math.rad(270), math.rad(360))
        arc(right-r, bottom-r, 0, math.rad(90))
        arc(left+r, bottom-r, math.rad(90), math.rad(180))
    end
end

local function espDrawHP(a, hum, ft, fb, fl, fr)
    local E = Config.ESP
    local style = E.HPBarStyle or 1
    local frac = math.clamp((hum.Health or 0) / math.max(hum.MaxHealth or 100, 1), 0, 1)
    local thick = 5
    local barX = fr + 4 + E.HPBarOffX
    local barY = ft + E.HPBarOffY
    local frameH = math.max(fb - ft, 12)

    if style == 3 then
        if a.HPBar.Visible then a.HPBar.Visible = false end
        if a.HPFill.Visible then a.HPFill.Visible = false end
        a.HPSegContainer.Visible = true
        a.HPSegContainer.Position = UDim2.fromOffset(barX, barY)
        a.HPSegContainer.Size = UDim2.fromOffset(thick, frameH)
        local gap = 1
        local segH = (frameH - 9*gap) / 10
        local filled = math.floor(frac*10 + 0.5)
        for i = 1, 10 do
            local s = a.HPSegments[i]
            s.Position = UDim2.fromOffset(0, (10-i)*(segH+gap))
            s.Size = UDim2.fromOffset(thick, segH)
            local t = (i <= filled) and 0 or 0.85
            if s.BackgroundTransparency ~= t then s.BackgroundTransparency = t end
            if not s.Visible then s.Visible = true end
        end
    else
        if a.HPSegContainer.Visible then a.HPSegContainer.Visible = false end
        if not a.HPBar.Visible then a.HPBar.Visible = true end
        if not a.HPFill.Visible then a.HPFill.Visible = true end
        a.HPBar.Position = UDim2.fromOffset(barX, barY)
        a.HPBar.Size = UDim2.fromOffset(thick, frameH)
        a.HPFill.AnchorPoint = Vector2.new(0,1)
        a.HPFill.Position = UDim2.fromOffset(barX, barY + frameH)
        a.HPFill.Size = UDim2.fromOffset(thick, math.max(frameH*frac, thick))
    end

    a.HPLabel.Visible = true
    local hpTxt = string.format("%d%%", math.floor(frac*100 + 0.5))
    if a._lastHPLabel ~= hpTxt then
        a.HPLabel.Text = hpTxt; a._lastHPLabel = hpTxt
    end
    a.HPLabel.Position = UDim2.fromOffset(barX + thick + 6 + E.HPTextOffX,
        ft + frameH*0.5 + E.HPTextOffY)
end

local function espRenderEntity(a, cam, camPos)
    local hum, head, root = a.hum, a.head, a.root
    if not head or not head.Parent or not hum or not hum.Parent or hum.Health <= 0 then
        espHide(a); return
    end

    local dist = (head.Position - camPos).Magnitude
    if dist > Config.ESP.MaxDist then espHide(a); return end

    -- distance-based stride for optimization
    local stride = 1
    if dist > 300 then stride = 2 end
    if dist > 700 then stride = 3 end
    if stride > 1 and (ESP_STATE.Frame % stride) ~= 0 then
        return
    end

    local hp, onScreen = cam:WorldToViewportPoint(head.Position)
    if not onScreen then espHide(a); return end

    local E = Config.ESP
    local hSize = math.clamp((E.HeadScale * 2500) / math.max(dist, 0.1), 4, 300)
    a.HeadImg.Size = UDim2.fromOffset(hSize, hSize)
    a.HeadImg.Position = UDim2.fromOffset(hp.X, hp.Y)
    if E.HideHead then
        if a._headVisible then a.HeadImg.Visible = false; a._headVisible = false end
    else
        if not a._headVisible then a.HeadImg.Visible = true; a._headVisible = true end
    end

    if not root or not root.Parent then
        espHideBones(a)
        if a._boxVisible then
            a.BoxFrame.Visible = false
            for i = 1, #a.BoxLines do
                if a.BoxLines[i].Visible then a.BoxLines[i].Visible = false end
            end
            a._boxVisible = false
        end
        if a._hpVisible then
            a.HPBar.Visible = false; a.HPFill.Visible = false
            a.HPSegContainer.Visible = false
            a.HPLabel.Visible = false; a.DistLabel.Visible = false
            a._hpVisible = false
        end
        return
    end

    local foot, fOn = cam:WorldToViewportPoint(root.Position + Vector3.new(0, -2.5, 0))
    if not fOn then espHide(a); return end

    local ft = hp.Y - hSize*0.5
    local fb = foot.Y + 15
    local baseW = math.max((1500/dist)*E.BoxWidthScale, hSize*0.6, 24)
    local fcX = (hp.X + foot.X)*0.5
    local fl = fcX - baseW*0.5
    local fr = fl + baseW

    if E.ESPMode == "Bones" or E.ESPMode == "Both" then
        espDrawBones(a, cam)
    else
        espHideBones(a)
    end

    if E.ESPMode == "Box" or E.ESPMode == "Both" then
        espDrawBox(a, fl, ft, fr, fb)
    elseif a._boxVisible then
        a.BoxFrame.Visible = false
        for i = 1, #a.BoxLines do
            if a.BoxLines[i].Visible then a.BoxLines[i].Visible = false end
        end
        a._boxVisible = false
    end

    if E.ShowHealth then
        espDrawHP(a, hum, ft, fb, fl, fr)
    else
        if a.HPBar.Visible then a.HPBar.Visible = false end
        if a.HPFill.Visible then a.HPFill.Visible = false end
        if a.HPSegContainer.Visible then a.HPSegContainer.Visible = false end
        if a.HPLabel.Visible then a.HPLabel.Visible = false end
    end

    if E.ShowDistance then
        a.DistLabel.Visible = true
        local dTxt = string.format("%dm", math.floor(dist*0.28 + 0.5))
        if a._lastDistLabel ~= dTxt then
            a.DistLabel.Text = dTxt; a._lastDistLabel = dTxt
        end
        a.DistLabel.Position = UDim2.fromOffset(fcX + E.DistOffX, fb + 4 + E.DistOffY)
    elseif a.DistLabel.Visible then
        a.DistLabel.Visible = false
    end

    a._hpVisible = E.ShowHealth
end

