local function saveScripts()
    if type(writefile) ~= "function" then return end
    pcall(writefile, SCRIPTS_FILE, HttpService:JSONEncode(Config.Scripts))
end
local function loadScripts()
    local function seed()
        Config.Scripts = {}
        for _, ds in ipairs(DEFAULT_SCRIPTS) do
            table.insert(Config.Scripts, {name=ds.name, code=ds.code, bind=ds.bind})
        end
    end
    if not readfile then seed(); return end
    local ok, d = pcall(readfile, SCRIPTS_FILE)
    if not ok or not d or d == "" then seed(); saveScripts(); return end
    local ok2, s = pcall(function() return HttpService:JSONDecode(d) end)
    if ok2 and type(s) == "table" then
        Config.Scripts = s
        if #Config.Scripts == 0 then seed(); saveScripts() end
    else
        seed(); saveScripts()
    end
end
loadScripts()

