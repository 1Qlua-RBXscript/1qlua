--==============================================================
-- GRAPHICS PAGE (compact helpers)
--==============================================================
local GraphicsGY = { y = 12 }
local getEff

do
    local GY, G = GraphicsGY, Config.Graphics

    local function step(h) GY.y = GY.y + h end
    local function hdr(text)
        mk("TextLabel", GraphicsPage, {
            BackgroundTransparency=1, Position=UDim2.fromOffset(20, GY.y),
            Size=UDim2.new(1,-40,0,20), Font=Enum.Font.Code, Text=text,
            TextColor3=mkColor(220,220,225), TextSize=14,
            TextXAlignment=Enum.TextXAlignment.Left, ZIndex=3,
        })
        step(24)
    end
    local function gNum(label, key, minV, maxV, after)
        local p = settingBlock(GraphicsPage, label, G[key],
            UDim2.fromOffset(20, GY.y), UDim2.fromOffset(488, 36), 11,
            function() return G[key] end)
        bind(p.FocusLost, function()
            local v = tonumber(p.Text)
            if v then
                G[key] = math.clamp(v, minV, maxV)
                p.Text = tostring(G[key])
                if after then after(G[key]) end
                saveSettingsFull()
            end
        end)
        step(42)
    end
    local function gCol(label, key, title, after, fallback)
        colorSwatch(GraphicsPage, label, UDim2.fromOffset(20, GY.y), UDim2.fromOffset(488, 42),
            function() return G[key] or fallback end,
            function(c) G[key] = c; if after then after(c) end; saveSettingsFull() end, title)
        step(48)
    end
    local function gToggle(label, key, after, get)
        toggleButton(GraphicsPage, label, G[key],
            UDim2.fromOffset(20, GY.y), UDim2.fromOffset(488, 28),
            function(v) G[key] = v; if after then after(v) end; saveSettingsFull() end,
            function() return G[key] end)
        step(34)
    end

    getEff = function(cls, name)
        local e = Lighting:FindFirstChild(name)
        if not e or not e:IsA(cls) then
            if e then e:Destroy() end
            e = Instance.new(cls); e.Name = name; e.Enabled = false; e.Parent = Lighting
        end
        return e
    end

    -- page header
    mk("TextLabel", GraphicsPage, {
        BackgroundTransparency=1, Position=UDim2.fromOffset(20,GY.y),
        Size=UDim2.new(1,-40,0,20), Font=Enum.Font.Code, Text="Graphics / Lighting",
        TextColor3=mkColor(210,210,215), TextSize=16,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=3,
    })
    step(24)
    mk("Frame", GraphicsPage, {
        BackgroundColor3=mkColor(50,50,55), BackgroundTransparency=0.5,
        Position=UDim2.fromOffset(20,GY.y), Size=UDim2.new(1,-40,0,2),
        BorderSizePixel=0, ZIndex=3,
    })
    step(12)

    -- LIGHTING
    hdr("LIGHTING")
    gNum("Brightness", "Brightness", 0, 100, function(v) Lighting.Brightness = v end)
    gNum("Clock Time (0-24)", "ClockTime", 0, 24, function(v) Lighting.ClockTime = v end)
    gNum("Exposure", "Exposure", -10, 10, function(v) Lighting.ExposureCompensation = v end)
    gNum("Geographic Latitude", "GeographicLatitude", -90, 90, function(v) Lighting.GeographicLatitude = v end)
    gToggle("Global Shadows", "GlobalShadows", function(v) Lighting.GlobalShadows = v end)
    toggleButton(GraphicsPage, "Env Diffuse", G.EnvDiffuse == 1,
        UDim2.fromOffset(20,GY.y), UDim2.fromOffset(488,28),
        function(v) G.EnvDiffuse = v and 1 or 0; Lighting.EnvironmentDiffuseScale = G.EnvDiffuse; saveSettingsFull() end,
        function() return G.EnvDiffuse == 1 end)
    step(34)
    toggleButton(GraphicsPage, "Env Specular", G.EnvSpecular == 1,
        UDim2.fromOffset(20,GY.y), UDim2.fromOffset(488,28),
        function(v) G.EnvSpecular = v and 1 or 0; Lighting.EnvironmentSpecularScale = G.EnvSpecular; saveSettingsFull() end,
        function() return G.EnvSpecular == 1 end)
    step(38)

    -- COLORS
    hdr("COLORS")
    gCol("Ambient", "Ambient", "Ambient Color", function(c) Lighting.Ambient = c end)
    gCol("Outdoor Ambient", "OutdoorAmbient", "Outdoor Ambient", function(c) Lighting.OutdoorAmbient = c end)
    gCol("ColorShift Top", "ColorShiftTop", "ColorShift Top", function(c) Lighting.ColorShift_Top = c end)
    gCol("ColorShift Bottom", "ColorShiftBottom", "ColorShift Bottom", function(c) Lighting.ColorShift_Bottom = c end)

    -- FOG
    hdr("FOG")
    gNum("Fog Start", "FogStart", -100000, 100000, function(v) Lighting.FogStart = v end)
    gNum("Fog End", "FogEnd", -100000, 100000, function(v) Lighting.FogEnd = v end)
