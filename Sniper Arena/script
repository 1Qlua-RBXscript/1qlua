runCustomScript = function(s)
    if not s or not s.code or s.code == "" then return end
    task.spawn(function()
        local loader = loadstring or load
        if not loader then
            pcall(function() StarterGui:SetCore("SendNotification",
                { Title="Custom Script", Text="loadstring unavailable", Duration=3 }) end)
            return
        end
        local fn, err = loader(s.code)
        if not fn then
            pcall(function() StarterGui:SetCore("SendNotification",
                { Title="Custom Script", Text="Load error: "..tostring(err), Duration=3 }) end)
            return
        end
        local ok, err2 = pcall(fn)
        if not ok then
            pcall(function() StarterGui:SetCore("SendNotification",
                { Title="Custom Script", Text="Runtime error", Duration=3 }) end)
        else
            pcall(function() StarterGui:SetCore("SendNotification",
                { Title="Custom Script", Text="Executed: "..tostring(s.name), Duration=2 }) end)
        end
    end)
end

