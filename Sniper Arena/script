-- main ESP render loop
bind(RunService.RenderStepped, function()
    if not Config.ESP.Enabled then
        if not ESP_STATE.Hidden then
            for _, a in pairs(ESPStorage) do espHide(a) end
            for _, a in pairs(ESPNPCStorage) do espHide(a) end
            ESP_STATE.Hidden = true
        end
        return
    end
    ESP_STATE.Hidden = false
    ESP_STATE.Frame = ESP_STATE.Frame + 1

    if ESP_STATE.Dirty then
        for _, a in pairs(ESPStorage) do espApplyStyle(a) end
        for _, a in pairs(ESPNPCStorage) do espApplyStyle(a) end
        ESP_STATE.Dirty = false
    end

    local cam = workspace.CurrentCamera
    if not cam then return end
    local camPos = cam.CFrame.Position

    for p, a in pairs(ESPStorage) do
        if Blacklist[p.UserId] then
            espHide(a)
        else
            local char = p.Character
            if char and (not a.head or not a.head.Parent) then
                espCacheChar(a, char)
            end
            espRenderEntity(a, cam, camPos)
        end
    end

    if Config.ESP.NPCESPEnabled then
        for m, a in pairs(ESPNPCStorage) do
            if not m.Parent then
                espHide(a); ESPNPCStorage[m] = nil
            else
                if not a.head or not a.head.Parent then espCacheChar(a, m) end
                espRenderEntity(a, cam, camPos)
            end
        end
    else
        for _, a in pairs(ESPNPCStorage) do espHide(a) end
    end
end)

