Runtime.Cleanup = function()
    if not Runtime.Running then return end
    Runtime.Running = false
    for i = 1, #Runtime.Connections do
        pcall(function() Runtime.Connections[i]:Disconnect() end)
    end
    if Runtime.CleanupFlight then pcall(Runtime.CleanupFlight) end
    local sp = workspace:FindFirstChild("SolaraParticles"); if sp then sp:Destroy() end
    for _, a in pairs(ESPStorage) do
        for i = 1, #(a.Lines or {}) do pcall(function() a.Lines[i]:Remove() end) end
        for i = 1, #(a.BoxLines or {}) do pcall(function() a.BoxLines[i]:Remove() end) end
    end
    for _, a in pairs(ESPNPCStorage) do
        for i = 1, #(a.Lines or {}) do pcall(function() a.Lines[i]:Remove() end) end
        for i = 1, #(a.BoxLines or {}) do pcall(function() a.BoxLines[i]:Remove() end) end
    end
    Gui:Destroy()
    if env.__MultiV5 == Runtime then env.__MultiV5 = nil end
end

