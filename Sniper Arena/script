local function applySnapshot(s)
    if type(s) ~= "table" then return end
    if type(s.Aim) == "table" then
        local a = s.Aim
        if type(a.Active)=="boolean" then Config.Aim.Active = a.Active end
        if tonumber(a.Smoothness) then Config.Aim.Smoothness = math.clamp(tonumber(a.Smoothness),0.01,1) end
        if tonumber(a.FOVRadius) then Config.Aim.FOVRadius = math.clamp(tonumber(a.FOVRadius),10,2000) end
        if type(a.AimKey)=="string" and Enum.KeyCode[a.AimKey] then Config.Aim.AimKey = Enum.KeyCode[a.AimKey] end
        if a.Mode=="Hold" or a.Mode=="Toggle" then Config.Aim.Mode = a.Mode end
        if a.AimType=="Camera" or a.AimType=="Real" then Config.Aim.AimType = a.AimType end
        if type(a.TargetPlayers)=="boolean" then Config.Aim.TargetPlayers = a.TargetPlayers end
        if type(a.TargetNPCs)=="boolean" then Config.Aim.TargetNPCs = a.TargetNPCs end
        if type(a.ShowFOV)=="boolean" then Config.Aim.ShowFOV = a.ShowFOV end
    end
    if type(s.Flight) == "table" then
        for _, k in ipairs({"Speed","Acceleration","TurnSpeed","SpeedMultiplier"}) do
            if tonumber(s.Flight[k]) then Config.Flight[k] = tonumber(s.Flight[k]) end
        end
    end
    if type(s.Binds) == "table" then
        local nb = {}
        for k, v in pairs(s.Binds) do
            if type(v)=="string" and Enum.KeyCode[v] then nb[k] = Enum.KeyCode[v] end
        end
        if nb.Flight == nil then nb.Flight = Enum.KeyCode.V end
        Config.Binds = nb
    end
    if type(s.FOV) == "table" then
        local c = tableToCol(s.FOV.Color); if c then Config.FOV.Color = c end
        if tonumber(s.FOV.Thickness) then Config.FOV.Thickness = math.clamp(tonumber(s.FOV.Thickness),0.5,10) end
        if tonumber(s.FOV.Transparency) then Config.FOV.Transparency = math.clamp(tonumber(s.FOV.Transparency),0,1) end
    end
    if type(s.UI) == "table" then
        local u = s.UI
        local a = tableToCol(u.Accent); if a then Config.UI.Accent = a end
        local b = tableToCol(u.Button); if b then Config.UI.Button = b end
        if tonumber(u.Scale) then Config.UI.Scale = math.clamp(tonumber(u.Scale),0.5,2) end
        if type(u.ToggleKey)=="string" and Enum.KeyCode[u.ToggleKey] then Config.UI.ToggleKey = Enum.KeyCode[u.ToggleKey] end
        if type(u.HeaderImage)=="string" and u.HeaderImage ~= "" then Config.UI.HeaderImage = u.HeaderImage end
        if type(u.Font)=="string" and Enum.Font[u.Font] then Config.UI.Font = Enum.Font[u.Font] end
        if tonumber(u.FontScale) then Config.UI.FontScale = math.clamp(tonumber(u.FontScale),0.5,3) end
    end
    if type(s.ESP) == "table" then
        local e, E = s.ESP, Config.ESP
        if type(e.Enabled)=="boolean" then E.Enabled = e.Enabled end
        if type(e.NPCESPEnabled)=="boolean" then E.NPCESPEnabled = e.NPCESPEnabled end
        if type(e.HeadImage)=="string" then E.HeadImage = e.HeadImage end
        for _, k in ipairs({"HeadScale","Thickness","MaxDist","BoxWidthScale","BoxThickness",
            "BoxTransparency","HPTextTransparency","DistTextTransparency","HPSize","DistSize",
            "StrokeTransparency","HPBarOffX","HPBarOffY","HPTextOffX","HPTextOffY","DistOffX","DistOffY"}) do
            local v = tonumber(e[k]); if v then E[k] = v end
        end
        if type(e.ESPMode)=="string" then E.ESPMode = e.ESPMode end
        local bs = tonumber(e.BoxStyle); if bs then E.BoxStyle = math.clamp(math.floor(bs),1,3) end
        local hps = tonumber(e.HPBarStyle); if hps then E.HPBarStyle = math.clamp(math.floor(hps),1,3) end
        if type(e.ShowHealth)=="boolean" then E.ShowHealth = e.ShowHealth end
        if type(e.ShowDistance)=="boolean" then E.ShowDistance = e.ShowDistance end
        if type(e.HideHead)=="boolean" then E.HideHead = e.HideHead end
        if type(e.StrokeEnabled)=="boolean" then E.StrokeEnabled = e.StrokeEnabled end
        if type(e.HPFont)=="string" and Enum.Font[e.HPFont] then E.HPFont = e.HPFont end
        if type(e.DistFont)=="string" and Enum.Font[e.DistFont] then E.DistFont = e.DistFont end
        local c
        c = tableToCol(e.BoxColor); if c then E.BoxColor = c end
        c = tableToCol(e.HPColor); if c then E.HPColor = c end
        c = tableToCol(e.HPTextColor); if c then E.HPTextColor = c end
        c = tableToCol(e.DistTextColor); if c then E.DistTextColor = c end
        if type(e.Highlight)=="table" then
            local h = e.Highlight
            if type(h.Enabled)=="boolean" then E.Highlight.Enabled = h.Enabled end
            local fc = tableToCol(h.FillColor); if fc then E.Highlight.FillColor = fc end
            local oc = tableToCol(h.OutlineColor); if oc then E.Highlight.OutlineColor = oc end
            local v
            v = tonumber(h.FillTransparency); if v then E.Highlight.FillTransparency = math.clamp(v,0,1) end
